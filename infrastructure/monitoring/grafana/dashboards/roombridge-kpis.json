{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "AI request rate",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(roombridge_ai_requests_total[5m]))", "legendFormat": "requests/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "5xx error rate",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "100 * sum(rate(roombridge_ai_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(roombridge_ai_requests_total[5m])), 0.000001)", "legendFormat": "errors" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "p95 AI latency",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(roombridge_ai_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Grounding pass rate",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "100 * sum(roombridge_compare_runs_total{grounding=\"passed\"}) / clamp_min(sum(roombridge_compare_runs_total), 1)", "legendFormat": "passed" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Comparison outcomes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [{ "expr": "sum by (grounding, explanation_source) (increase(roombridge_compare_runs_total[1h]))", "legendFormat": "{{grounding}} / {{explanation_source}}" }]
    },
    {
      "type": "timeseries",
      "title": "RoomProof report status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [{ "expr": "sum by (status) (increase(roombridge_roomproof_reports_total[1h]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries",
      "title": "Evidence findings",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [{ "expr": "sum by (finding_status, severity) (increase(roombridge_roomproof_findings_total[1h]))", "legendFormat": "{{finding_status}} / {{severity}}" }]
    },
    {
      "type": "stat",
      "title": "Q&A abstention rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [{ "expr": "100 * sum(roombridge_roomproof_questions_total{outcome=\"abstained\"}) / clamp_min(sum(roombridge_roomproof_questions_total), 1)", "legendFormat": "abstained" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["roombridge", "llmops", "kpi"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "RoomBridge AI Operations",
  "uid": "roombridge-ai-ops",
  "version": 1
}
