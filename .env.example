CLIENT_ORIGIN=http://localhost:5173

# Create a key at https://app.rentcast.io/app/api
# Keep this server-side only. Do not put it in VITE_* variables.
RENTCAST_API_KEY=your_rentcast_api_key_here

# Optional. Used only when a user opens listing contact details.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Internal FastAPI Compare & Match agent.
AI_SERVICE_URL=http://127.0.0.1:8001

# Read-only RoomBridge MCP server.
MCP_SERVER_URL=http://127.0.0.1:8002/mcp
